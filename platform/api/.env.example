NODE_ENV=development
PORT=5000
HOST=127.0.0.1

# Database
DATABASE_URL=postgres://mellucode:CHANGE_ME@127.0.0.1:5432/mellucode_dev

# Auth
JWT_SECRET=CHANGE_ME_TO_RANDOM_64_CHAR_STRING
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# CORS (origins separate by comma; * = allow all in dev)
CORS_ORIGINS=*

# OpenRouter (per Fase 3 AI proxy)
OPENROUTER_API_KEY=

# SMTP (per Fase 1 email)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=MelluCode <noreply@mellucode.mellutecno.it>
